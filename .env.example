# Copy to .env and fill in. Never commit .env.
BASE_URL=https://api.practicesoftwaretesting.com
# Optional: sent as "Authorization: Bearer <token>" when set
API_TOKEN=
# Optional: request timeout in milliseconds
TIMEOUT_MS=30000
# Admin account for endpoints that need auth (e.g. DELETE /brands/{id}).
# Toolshop's demo accounts are listed at https://practicesoftwaretesting.com
ADMIN_EMAIL=
ADMIN_PASSWORD=
